APP_NAME=quitanda.app
APP_ENV=local
APP_KEY=
# Mantenha false por padrão (produção); habilite true apenas no seu .env local.
APP_DEBUG=false
APP_URL=http://localhost
# Atrás de proxy/túnel HTTPS: IPs confiáveis separados por vírgula (ou * em dev). Vazio = não confia em nenhum.
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Valores do `docker-compose.yml` (serviço `db`, PostgreSQL 16). A aplicação usa
# jsonb, índices parciais e lockForUpdate: SQLite não é suportado.
# Dentro do container o host é `db` e a porta 5432; do host da máquina use
# 127.0.0.1:5433. Em produção troque TODAS as credenciais abaixo.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=wl
DB_USERNAME=wl
DB_PASSWORD=wl

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Flag `Secure` dos cookies de sessão e do cliente (customer_session_*,
# login_popup_dismissed_*). Se omitido: true quando APP_ENV=production, false
# nos demais. Em produção (HTTPS) deixe omitido ou true; só defina false se
# o ambiente realmente não usar HTTPS.
# SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Mercado Pago (API de Orders). O access token e o webhook secret NÃO ficam aqui: são por
# tenant, cifrados em tenants.settings e editados em Admin > Pagamentos.
# Identificador de integrador enviado no header `X-Integrator-Id` (atribuição de vendas ao
# integrador; NÃO é credencial). VAZIO por padrão: o header só é enviado se preenchido, e o
# valor deve ser o do seu próprio cadastro de integrador.
# MERCADOPAGO_INTEGRATOR_ID=
# Validade do Pix, duração ISO 8601 entre PT30M (30 min) e P30D (30 dias). Padrão: PT30M.
# MERCADOPAGO_PIX_EXPIRATION=PT30M
# Janela (segundos) em que o cliente pode pagar o Pix; vencida, o servidor cancela a order no MP e o
# pedido. Padrão e TETO 300 (5 min), piso 60. Independe do PT30M acima (mínimo do MP).
# MERCADOPAGO_PIX_WINDOW=300
# Espera máxima (s) pelo QR do Pix logo após criar a order (0 = não espera; o polling busca). Padrão: 8.
# MERCADOPAGO_PIX_QR_WAIT=8

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
